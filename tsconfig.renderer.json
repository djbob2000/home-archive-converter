{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ES2020",
    "target": "ES2020",
    "moduleResolution": "node",
    "outDir": "dist",
    "lib": ["DOM", "ES2020"]
  },
  "include": ["src/renderer/**/*"],
  "exclude": ["node_modules", "dist", "release"]
}
